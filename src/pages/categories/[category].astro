---
/*
 * /categories/* → the section pages.
 *
 * Categories used to be the browse axis (Reviews / Resources / OSWR /
 * Olde Swords Reign / Methodology / How To / Mutant Mondays). The four
 * sections replaced them on 2026-07-30, so these URLs would otherwise be
 * duplicate content for /play, /reading, /making and /method.
 *
 * Both the current section slugs and the seven retired category slugs are
 * kept alive here — the retired ones sat in the live sitemap for months and
 * may be indexed or linked. They should land somewhere sensible, not 404.
 */
import { SECTIONS } from '../../lib/sections';

export async function getStaticPaths() {
  // Retired category slug → the section that absorbed it.
  const RETIRED: Record<string, string> = {
    'reviews': 'reading',
    'resources': 'reading',
    'oswr': 'making',
    'olde-swords-reign': 'making',
    'methodology': 'method',
    'how-to': 'method',
    'mutant-mondays': 'play',
  };

  const paths = SECTIONS.map((s) => ({
    params: { category: s.slug },
    props: { target: `/${s.slug}` },
  }));

  for (const [from, to] of Object.entries(RETIRED)) {
    // Don't emit a duplicate route if a retired slug matches a live section.
    if (SECTIONS.some((s) => s.slug === from)) continue;
    paths.push({ params: { category: from }, props: { target: `/${to}` } });
  }

  return paths;
}

const { target } = Astro.props;
const fullUrl = `https://fumbletable.com${target}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href={fullUrl} />
    <title>Redirecting...</title>
  </head>
  <body>
    <p>This page has moved to <a href={target}>{target}</a>.</p>
  </body>
</html>
