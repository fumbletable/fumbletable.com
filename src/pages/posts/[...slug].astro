---
import Post from '../../layouts/Post.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

// Auto-extract first YouTube embed URL from body (if no explicit video in frontmatter)
const youtubeMatch = post.body?.match(/src="(https?:\/\/www\.youtube[^"]+)"/);
const video = post.data.video || (youtubeMatch ? youtubeMatch[1] : undefined);

/*
 * Related posts — rank by shared tags first, then fall back to the section.
 *
 * Sections are deliberately coarse (Reading alone holds ~35 posts), so
 * "same category" on its own picks near-randomly. Tags carry the actual
 * topic, so a post about free adventures should surface other free
 * adventures, not whatever happened to be published most recently.
 */
const allPosts = await getCollection('posts');
const currentCategories = post.data.categories || [];
const currentTags = new Set(post.data.tags || []);

const related = allPosts
  .filter(p => p.id !== post.id)
  .map(p => ({
    post: p,
    sharedTags: (p.data.tags || []).filter(t => currentTags.has(t)).length,
    sameSection: (p.data.categories || []).some(c => currentCategories.includes(c)),
  }))
  .filter(c => c.sharedTags > 0 || c.sameSection)
  .sort((a, b) =>
    b.sharedTags - a.sharedTags ||
    Number(b.sameSection) - Number(a.sameSection) ||
    b.post.data.date.getTime() - a.post.data.date.getTime()
  )
  .slice(0, 3)
  .map(({ post: p }) => ({
    title: p.data.title,
    slug: p.id,
    categories: p.data.categories || [],
    image: p.data.image,
  }));
---

<Post
  title={post.data.title}
  date={post.data.date}
  categories={post.data.categories}
  tags={post.data.tags}
  image={post.data.image}
  subtitle={post.data.subtitle}
  video={video}
  verdict={post.data.verdict}
  product={post.data.product}
  downloads={post.data.downloads}
  relatedPosts={related}
>
  <Content />
</Post>
